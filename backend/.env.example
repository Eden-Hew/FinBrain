GEMINI_API_KEY=
TOKEN_ROOT_SECRET=replace-with-at-least-32-random-characters
TOKEN_HASH_SECRET=replace-with-a-stable-32-byte-token-identity-secret
VAULT_MASTER_KEY=replace-with-an-independent-32-byte-vault-master-key
VAULT_AUTO_ROTATION_ENABLED=false
VAULT_ROTATION_INTERVAL_DAYS=30
VAULT_ROTATION_CHECK_SECONDS=60
VAULT_ROTATION_BATCH_SIZE=100
DATABASE_URL=sqlite:///./finbrain.db
DATABASE_POOL_SIZE=1
DATABASE_MAX_OVERFLOW=1
DATABASE_POOL_TIMEOUT=10
# Supabase example (copy the exact URI from Dashboard > Connect and URL-encode the password):
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_JWT_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=RS256,ES256
# service_role secret key (Dashboard > Project Settings > API). Server-side only — never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
EINVOICE_DOCUMENT_BUCKET=einvoice-documents
GEMINI_REASONING_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TIMEOUT_SECONDS=12
MORPHEUS_API_KEY=
MORPHEUS_BASE_URL=https://api.mor.org/api/v1
MORPHEUS_MODEL=deepseek-v4-flash
MORPHEUS_TIMEOUT_SECONDS=20
# Uses only bounded, tokenized conversation history. Exact/list/count queries bypass it.
CONVERSATION_PLANNER_ENABLED=true
CONVERSATION_PLANNER_TIMEOUT_SECONDS=6
ENABLE_GLINER=true
GLINER_MODEL_NAME=urchade/gliner_multi_pii-v1
GLINER_DEVICE=cpu
GLINER_CPU_THREADS=2
# Local launcher overrides this to true for the API process. Keep false in the 4 GB container.
PREWARM_GLINER_ON_STARTUP=false
ALLOW_OFFLINE_DEMO=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1):517[3-9]$
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
TELEGRAM_OPERATOR_ROLES=
TELEGRAM_ALLOWED_CHAT_TYPES=private
TELEGRAM_DRAFT_TTL_SECONDS=600
TELEGRAM_MAX_FILE_BYTES=10000000
TELEGRAM_MAX_EXTRACTED_CHARS=100000
TELEGRAM_MAX_PDF_PAGES=50
TELEGRAM_MAX_DOCX_MEMBERS=1000
TELEGRAM_MAX_DOCX_UNCOMPRESSED_BYTES=25000000
TELEGRAM_DELETE_SOURCE_AFTER_INGEST=false
TELEGRAM_STATUS_LIMIT=5
TELEGRAM_HEARTBEAT_SECONDS=30
TELEGRAM_PREVIEW_CHARS=1200
TELEGRAM_ENRICHMENT_CONCURRENCY=1
TELEGRAM_CUSTOMER_ONBOARDING_ENABLED=false
TELEGRAM_CUSTOMER_TENANT_ID=00000000-0000-0000-0000-000000000001
TELEGRAM_OUTBOUND_ENABLED=false
TELEGRAM_REMINDER_INTERVAL_SECONDS=3600
TELEGRAM_OUTBOUND_INTERVAL_SECONDS=5
TELEGRAM_OUTBOUND_BATCH_SIZE=10
EMAIL_CONNECTOR_ENABLED=false
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USERNAME=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_FOLDER=INBOX
EMAIL_IMAP_USE_SSL=true
EMAIL_SYNC_INTERVAL_SECONDS=60
EMAIL_MAX_MESSAGES_PER_SYNC=25
EMAIL_INCLUDE_ATTACHMENTS=true
CUSTOMER_INTELLIGENCE_ENABLED=false
CUSTOMER_ATTENTION_ENABLED=false
OUTBOUND_EMAIL_ENABLED=false
EMAIL_REPLY_CORRELATION_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_STARTTLS=true
EMAIL_SMTP_FROM_ADDRESS=
EMAIL_OUTREACH_SIGNATURE_NAME=FinBrain Team
EMAIL_OUTREACH_SIGNATURE_TITLE=Customer Operations
EMAIL_OUTREACH_SIGNATURE_ORGANIZATION=FinBrain
EMAIL_OUTBOUND_BATCH_SIZE=5
EMAIL_SEND_TIMEOUT_SECONDS=15
EMAIL_SENDING_STALE_SECONDS=120
STRUCTURED_CSV_MAX_FILE_BYTES=10000000
STRUCTURED_CSV_MAX_ROWS=500
STRUCTURED_CSV_MAX_COLUMNS=20
STRUCTURED_CSV_MAX_CELL_CHARS=4000
APPLICATION_TIMEZONE=Asia/Kuala_Lumpur
# Optional heartbeat namespace. Defaults to local, or Railway's injected service ID in deployment.
SERVICE_INSTANCE_ID=
